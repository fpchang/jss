<view class="flex-page">
  <view class="flex-page-nav">
    <van-nav-bar title="创建订单" left-text="" left-arrow bind:click-left="onClickLeft">
    </van-nav-bar>
    <view>
    </view>
  </view>
  <view class="flex-page-content">
    <view class="order-page-style">
      <view>
        <van-cell title="来源" center data-name="1">
          <van-radio-group value="{{ source }}" bind:change="onChange">
            <van-radio custom-class="radio-style" name="1" checked-color="#07c160">携程</van-radio>
            <van-radio custom-class="radio-style" name="2" checked-color="#07c160">美团</van-radio>
            <van-radio custom-class="radio-style" name="3" checked-color="#07c160">美团民宿</van-radio>
            <van-radio custom-class="radio-style" name="4" checked-color="#07c160">线下</van-radio>
          </van-radio-group>
        </van-cell>
        <van-cell title="选择日期区间" value="{{ dateRangeFormat }}" bind:click="onDisplay" />
        <van-calendar show="{{ showSelectDate }}" required type="range" bind:close="onClose" bind:confirm="onDateSelectConfirm" />
        <van-cell title="房间" center data-name="1">
          <van-checkbox-group value="{{ roomSelectList }}" bind:change="roomChange">
            <van-checkbox shape="square" custom-class="radio-style" name="201" checked-color="#07c160">201</van-checkbox>
            <van-checkbox shape="square" custom-class="radio-style" name="202" checked-color="#07c160">202</van-checkbox>
            <van-checkbox shape="square" custom-class="radio-style" name="203" checked-color="#07c160">203</van-checkbox>
            <van-checkbox shape="square" custom-class="radio-style" name="204" checked-color="#07c160">204</van-checkbox>
          </van-checkbox-group>
        </van-cell>
        <van-cell-group>
          <van-field  required clearable label="用户名" icon="question-o" placeholder="请输入用户名" bind:click-icon="onClickIcon" model:value="{{ userName }}"/>

          <van-field model:value="{{ phone }}"  label="手机号" placeholder="请输入手机号" border="{{ false }}" />
          <van-field wx:if="{{source=='4'}}" value="{{ wxName }}" required clearable label="微信号" icon="question-o" placeholder="请输入微信号" bind:click-icon="onClickIcon" />
        </van-cell-group>



        <van-button disabled="{{commitButtonDidabled}}" type="primary" size="large" bind:click="commitOrder">提交</van-button>
      </view>
    </view>
  </view>
</view>