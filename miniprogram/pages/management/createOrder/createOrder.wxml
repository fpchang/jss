<view class="flex-page">
  <view class="flex-page-nav">
    <van-nav-bar title="创建订单" left-text="" left-arrow  bind:click-left="onClickLeft">
    </van-nav-bar>
    <view>
    </view>
  </view>
  <view class="flex-page-content">
    <view class="order-page-style">
      <view>
        <van-cell-group>
          <van-field value="{{ username }}" required clearable label="用户名" icon="question-o" placeholder="请输入用户名" bind:click-icon="onClickIcon" />

          <van-field value="{{ phone }}" type="password" label="手机号" placeholder="请输入手机号" border="{{ false }}" />
          <van-field value="{{ username }}" required clearable label="微信号" icon="question-o" placeholder="请输入微信号" bind:click-icon="onClickIcon" />
        </van-cell-group>
        <van-cell title="选择日期区间" value="{{ date }}" bind:click="onDisplay" />
        <van-calendar show="{{ showSelectDate }}" type="range" bind:close="onClose" bind:confirm="onConfirm" />
        <van-cell title="来源" center data-name="1">
          <van-radio-group   value="{{ radio }}" bind:change="onChange">
          <van-radio custom-class ="radio-style" name="1" checked-color="#07c160">携程</van-radio>
          <van-radio custom-class ="radio-style" name="2" checked-color="#07c160">美团</van-radio>
          <van-radio custom-class ="radio-style" name="3" checked-color="#07c160">美团民宿</van-radio>
          <van-radio custom-class ="radio-style" name="4" checked-color="#07c160">线下</van-radio>
        </van-radio-group>
    </van-cell>
        
        <van-button type="primary" size="large">提交</van-button>
      </view>
    </view>
  </view>
</view>