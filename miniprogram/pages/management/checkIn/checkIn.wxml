<view class="flex-page">
  <view class="flex-page-nav">
    <van-nav-bar title="订单信息" left-text="" left-arrow bind:click-left="onClickLeft">
    </van-nav-bar>
    <view>
    </view>
  </view>
  <view class="flex-page-content">
    <view style="display: flex;">
      <view class="left-table-style">
        <view class="th-style">房间号</view>
        <view  class="td-style" wx:for="{{roomIdList}}">{{item}}</view>
      </view>
      <view class="checkInTable-style" style="flex: 1;">
        <view class="checkIntable-content">
          <view>
            <view class="checkIntable-h-list">
              <view class=" th-style checkIntable-h-list-h" style="line-height: 75rpx;background-color: #eee;" wx:for="{{dateListFormat}}" wx:for-item="item">  
                <view>{{item.de}}</view><view style="font-size: 35rpx;">{{item.dy}}</view> 
              </view>
            </view>
            <view class="checkIntable-h-list" wx:for="{{roomIdList}}" wx:for-item="item">
              <view class="checkIntable-h-list-h td-style {{it.isBalancePayment?'isContinueCheckIn':''}}" wx:for="{{getFormatTableList[item]}}" wx:for-item="it" bindtap="showDetail" data-detail="{{it}}">{{it.userName?it.userName:''}}</view>
            </view>

          </view>
        </view>
        <view class="checkIntable-h-head" style="flex-direction: column;">

        </view>
      </view>
    </view>


  </view>
</view>
<van-popup show="{{ showPopu }}" bind:close="onClose">
<view style="width: 500rpx;padding:30rpx">
  <view>尾款：{{popuJson.balancePayment}} 元</view>
  <view>{{popuJson.mark}}</view>
</view>
 
</van-popup>